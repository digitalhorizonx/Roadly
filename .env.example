# Canonical site URL (no trailing slash). Used for canonicals, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://roadly.digitalhorizonx.com

# Optional: webhook that receives contact form submissions as JSON
# (e.g. Zapier, Make, Slack incoming webhook, or your own endpoint).
# When unset, submissions are logged to the server console.
CONTACT_WEBHOOK_URL=
